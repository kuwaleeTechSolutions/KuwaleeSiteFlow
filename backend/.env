APP_NAME="Kuwalee SiteFlow"
APP_ENV=local
APP_KEY=base64:CqfEBArOzhABBnD7HNxZJoaBc7axY0U4lZkK8XqG7yA=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://127.0.0.1:8000
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:5173,localhost:5173,127.0.0.1:3000,localhost:3000
SESSION_DRIVER=file
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# IMPORTANT: APP_DEBUG must be false in production. Never expose stack traces,
# SQL, or server paths to clients — see App\Exceptions\Handler.

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kuwalee_siteflow
DB_USERNAME=root
DB_PASSWORD=mY@jobs4848

# Sanctum SPA (cookie-based) authentication
# The frontend origin(s) that are allowed to authenticate via cookies.


# Never store the auth token in localStorage. Sanctum SPA mode relies on the
# encrypted, HttpOnly session cookie above.

CACHE_STORE=file
QUEUE_CONNECTION=sync

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# File storage — documents/photos must NEVER use the `public` disk.
FILESYSTEM_DISK=local
DOCUMENTS_DISK=private-documents
DOCUMENTS_DOWNLOAD_URL_TTL_SECONDS=120

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@kuwaleesiteflow.com"
MAIL_FROM_NAME="${APP_NAME}"

# Compliance expiry alert thresholds (days), comma separated, configurable per org
COMPLIANCE_ALERT_THRESHOLDS=60,30,15,7

# Login rate limiting
LOGIN_THROTTLE_ATTEMPTS=5
LOGIN_THROTTLE_DECAY_SECONDS=60
